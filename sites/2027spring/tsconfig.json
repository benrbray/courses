{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "paths": {
      "@components/*" : [ "./src/components/*" ],
      "@layout/*" : [ "./src/components/layout/*" ],
      "@styles/*"     : [ "./src/styles/*" ],
      "@util/*"       : [ "./src/util/*" ]
    },
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  }
}