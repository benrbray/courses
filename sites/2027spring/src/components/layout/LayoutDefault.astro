---
import IncludeCss from "./IncludeCss.astro";

interface Props {
	pageTitle: string,
	theme?: string|undefined,
}

const { pageTitle, theme } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>

<html lang="en">
  <head>
    <title>{pageTitle}</title>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href=`${baseUrl}/favicon.svg` />
		<link rel="icon" href=`${baseUrl}/favicon.ico` />
		<meta name="viewport" content="width=device-width" />
    <IncludeCss />
  </head>
	<body class={theme ? `theme-${theme}` : "theme-default"}>
		<!-- Page Header -->
		<div class="header">
			<div class="header-title">
				Data Structures (CIS 2168, Fall 2026)
			</div>
		</div>
		<!-- Sidebar -->
		<div class="left-side">
			<nav class="sidebar-nav">
				<details class="nav-section" open>
					<summary>Syllabus</summary>
					<nav class="section-nav">
						<div class="section-nav-item"><a href="#">Description</a></div>
						<div class="section-nav-item"><a href="#">Schedule</a></div>
					</nav>
				</details>
				<details class="nav-section">
					<summary>Homework</summary>
					<nav class="section-nav">
						<div class="section-nav-item"><a href="#">HW1 (Ordered Lists & Iterators)</a></div>
					</nav>
				</details>
			</nav>
		</div>
		<!-- Content -->
		<div class="content">
			<slot />
		</div>
		<!-- Right Side -->
		<div class="right-side">

		</div>
  </body>
</html>

<style>
body {
	display: grid;
	grid-template-rows: auto 1fr;
	grid-template-columns: 1fr minmax(24em, auto) 1fr;
	grid-template-areas:
		"header header header"
		"left content right"
		"footer footer footer";
	
	min-height: 100vh;
	margin: 0;
	gap: 0 2em;

	font-family: Optima, Candara, 'Noto Sans', source-sans-pro, sans-serif;
	font-weight: normal;
}

/* ---- header ---- */

.header {
	grid-area: header;
	background-color: rgb(68, 68, 124);

	
}
.header-title {
	font-size: 1.2rem;
	padding: var(--gap-2);
	color: white;
}

/* ---- sidebar ---- */

.left-side {
	grid-area: left;

	display: flex;
	justify-content: flex-end;

	background-color: rgb(243, 243, 243);
}

.sidebar-nav {
	flex-basis: 18em;
}

.nav-section summary {
	display: block; /* removes default details arrow */
	padding: 0.5em;
}

.nav-section summary:hover {
	background-color: rgb(197, 197, 226);
}

.section-nav-item {
	padding: 0.5em;
	padding-left: 1.5em;
}
.section-nav-item:hover {
	background-color: #ddd;
}

.right-side {
	grid-area: right;
	background-color: white;
}

/* ---- content ---- */

.content {
	grid-area: content;
	padding: var(--gap-1);
	max-width: 60rem;
}
.footer {
	grid-area: footer;
}
</style>