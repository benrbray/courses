---
import NavCourses from '@components/NavCourses.astro';
import ColumnNormal from '@layout/ColumnNormal.astro';
import LayoutBlock from '@layout/LayoutBlock.astro';
import LayoutDefault from '@layout/LayoutDefault.astro';

import { getCollection } from 'astro:content';
import { type CollectionEntry, render } from 'astro:content';
// import { getCoursePosts } from '../../util/query';

export async function getStaticPaths() {
	const course = await getCollection("course")
	return course.map((course) => ({
		params: { id: course.id },
		props: course,
	}));
}
type Props = CollectionEntry<'course'>;

const course = Astro.props;
const { Content } = await render(course);

// get all posts for this course
// const posts = await getCoursePosts(course.id)
---

<LayoutDefault
	pageTitle={`${course.data.subject} ${course.data.number}`}
	theme={course.data.theme}
>
	<ColumnNormal>
		<!-- nav -->
		<NavCourses />
		<!-- header -->
		<LayoutBlock>
			<h1>{course.data.subject} {course.data.number}: {course.data.title}</h1>
			Temple University, Japan Campus
		</LayoutBlock>
		<!-- main -->
		<LayoutBlock>
			<Content />
		</LayoutBlock>
	</ColumnNormal>
</LayoutDefault>