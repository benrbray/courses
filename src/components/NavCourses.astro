---
import InternalLink from "./InternalLink.astro";
---

<nav class="nav">
  <div class="nav-courses">
    <div><em>Fall 2026</em></div>
    <div><InternalLink href="/temple/cis1051">1051</InternalLink></div>
    <div><InternalLink href="/temple/cis2168">2168</InternalLink></div>
    <div><InternalLink href="/temple/cis3308">3308</InternalLink></div>
  </div>
</nav>

<style>
.nav {
  display: flex;
  justify-content: flex-end;

  margin: var(--gap-2) 0;
}

.nav-courses {
  display: flex;

  padding: var(--gap-0) var(--gap-1);
  border-radius: var(--gap-1);

  gap: var(--gap-2);
  font-size: 1.2rem;
  justify-content: flex-end;

  font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans';

  background-color: var(--theme-pattern-bg);
}

.nav-courses div {
}

.nav-courses a {
  text-decoration: none;
  font-weight: bold;
  color: rgb(22, 66, 161);
}

.sc {
  font-variant: small-caps;
}
</style>