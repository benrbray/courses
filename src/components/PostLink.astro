---
import { getEntry, type CollectionEntry } from 'astro:content';
import { isPublished } from "../util/query.ts";

interface Props {
  postId: CollectionEntry<'post'>["id"]
}

const { postId } = Astro.props;

const post = await getEntry({ collection: "post", id: postId })!;
---

<div>
  <a
    href={`${post.id}`}
    class={!isPublished(post) ? "unpublished" : ""}
  >{post.data.title}</a>
</div>

