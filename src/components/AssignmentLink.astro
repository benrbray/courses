---
import { getEntry, type CollectionEntry } from 'astro:content';
import { isPublished } from "../util/query.ts";

interface Props {
  assignmentId: CollectionEntry<'assignment'>["id"]
}

const { assignmentId } = Astro.props;

const assignment = await getEntry({ collection: "assignment", id: assignmentId })!;

const course = assignment.data.course.id;
const kind = assignment.data.kind;
const id = assignment.id.split("/")[2];
---

<div>
  <a
    href={`${course}/${kind}/${id}`}
    class={!isPublished(assignment) ? "unpublished" : ""}
  >{assignment.data.title}</a>
</div>

