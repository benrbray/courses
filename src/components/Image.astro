---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  alt?: string,
  path: string,
}

const { alt, path } = Astro.props;

// grab all images from assets folder
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif,svg}');

console.log("----\n", images);
// safety check to verify file exists
if (!images[path]) {
  throw new Error(`"${path}" does not exist in glob.`);
}

---

<Image
  src={images[path]()}
  layout='constrained'
  alt={alt || "(no image description)"}
/>